{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "children",
  "description": "Capability for the palette, panel and queue windows the main window opens",
  "windows": ["palette", "settings", "search", "source", "queue", "update", "whats-new"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-close"
  ]
}
